rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Primitive Helpers (Phase 3)
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'lohithadiver123@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() && (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
        )
      );
    }

    function isDepartmentOfficerFor(deptId) {
      return isVerifiedUser() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'DEPARTMENT_OFFICER' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.departmentId == deptId;
    }

    // =========================================================================
    // Validation Blueprints (Anti-Update-Gap)
    // =========================================================================
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'role', 'departmentId', 'departmentName', 'ward', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role in ['CITIZEN', 'DEPARTMENT_OFFICER', 'ADMIN']
        && (!('departmentId' in data) || (isValidId(data.departmentId) && data.departmentId.size() <= 64))
        && (!('departmentName' in data) || (data.departmentName is string && data.departmentName.size() <= 120))
        && (!('ward' in data) || (data.ward is string && data.ward.size() <= 32))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'citizenPhone', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('citizenPhone' in data) || (data.citizenPhone is string && data.citizenPhone.size() <= 32))
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'grantedBy', 'createdAt'])
        && isValidId(data.uid)
        && isValidId(data.grantedBy)
        && data.createdAt is timestamp;
    }

    function isValidComplaint(data) {
      return data.keys().hasAll([
          'ticketCode', 'title', 'description', 'sectorId', 'sectorName', 'sectorIcon',
          'severity', 'priorityScore', 'department', 'departmentId', 'status', 'ward',
          'locationName', 'lat', 'lng', 'reportedAt', 'reporterUid', 'citizenName',
          'aiReasoning', 'recommendedAction', 'slaHours', 'visibility', 'upvoteCount',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ticketCode', 'title', 'description', 'sectorId', 'sectorName', 'sectorIcon',
          'severity', 'priorityScore', 'department', 'departmentId', 'status', 'ward',
          'locationName', 'lat', 'lng', 'reportedAt', 'resolvedAt', 'reporterUid',
          'citizenName', 'language', 'imageUrl', 'aiReasoning', 'recommendedAction',
          'assignedTeam', 'slaHours', 'timeRemaining', 'visibility', 'upvoteCount',
          'createdAt', 'updatedAt'
        ])
        && data.ticketCode is string && data.ticketCode.size() >= 4 && data.ticketCode.size() <= 20 && data.ticketCode.matches('^CL-[0-9]{1,10}$')
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 4000
        && data.sectorId is string && data.sectorId.size() == 2 && data.sectorId.matches('^[0-9]{2}$')
        && data.sectorName is string && data.sectorName.size() >= 1 && data.sectorName.size() <= 100
        && data.sectorIcon is string && data.sectorIcon.size() >= 1 && data.sectorIcon.size() <= 16
        && data.severity in ['CRITICAL', 'HIGH', 'MEDIUM', 'LOW']
        && data.priorityScore is number && data.priorityScore >= 0 && data.priorityScore <= 100
        && data.department is string && data.department.size() >= 1 && data.department.size() <= 120
        && isValidId(data.departmentId) && data.departmentId.size() <= 64
        && data.status in ['New', 'Assigned', 'In Progress', 'Resolved']
        && data.ward is string && data.ward.size() >= 1 && data.ward.size() <= 32
        && data.locationName is string && data.locationName.size() >= 1 && data.locationName.size() <= 200
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.reportedAt is string && data.reportedAt.size() >= 1 && data.reportedAt.size() <= 64
        && (!('resolvedAt' in data) || (data.resolvedAt is string && data.resolvedAt.size() <= 64))
        && isValidId(data.reporterUid)
        && data.citizenName is string && data.citizenName.size() >= 1 && data.citizenName.size() <= 120
        && (!('language' in data) || (data.language is string && data.language.size() <= 64))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000))
        && data.aiReasoning is string && data.aiReasoning.size() >= 1 && data.aiReasoning.size() <= 1000
        && data.recommendedAction is string && data.recommendedAction.size() >= 1 && data.recommendedAction.size() <= 1000
        && (!('assignedTeam' in data) || (data.assignedTeam is string && data.assignedTeam.size() <= 120))
        && data.slaHours is number && data.slaHours >= 1 && data.slaHours <= 168
        && (!('timeRemaining' in data) || (data.timeRemaining is string && data.timeRemaining.size() <= 32))
        && data.visibility in ['PUBLIC', 'PRIVATE']
        && data.upvoteCount is number && data.upvoteCount >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidComplaintUpvote(data) {
      return data.keys().hasAll(['userId', 'complaintId', 'createdAt'])
        && data.keys().hasOnly(['userId', 'complaintId', 'createdAt'])
        && isValidId(data.userId)
        && isValidId(data.complaintId)
        && data.createdAt is timestamp;
    }

    function isValidAppNotification(data) {
      return data.keys().hasAll(['recipientUid', 'title', 'message', 'type', 'read', 'createdAt'])
        && data.keys().hasOnly(['recipientUid', 'title', 'message', 'type', 'ticketId', 'read', 'createdAt'])
        && isValidId(data.recipientUid)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 1000
        && data.type in ['critical', 'success', 'info']
        && (!('ticketId' in data) || (data.ticketId is string && data.ticketId.size() <= 64))
        && data.read is bool
        && data.createdAt is timestamp;
    }

    function isValidPlatformSettings(data) {
      return data.keys().hasAll(['modelAccuracy', 'autoDispatch', 'criticalSLAHours', 'highSLAHours', 'notificationSound', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['modelAccuracy', 'autoDispatch', 'criticalSLAHours', 'highSLAHours', 'notificationSound', 'updatedBy', 'updatedAt'])
        && data.modelAccuracy is string && data.modelAccuracy.size() >= 1 && data.modelAccuracy.size() <= 64
        && data.autoDispatch is bool
        && data.criticalSLAHours is number && data.criticalSLAHours >= 1 && data.criticalSLAHours <= 24
        && data.highSLAHours is number && data.highSLAHours >= 1 && data.highSLAHours <= 72
        && data.notificationSound is bool
        && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    // =========================================================================
    // Collection Rules
    // =========================================================================

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedAdmin();

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid
        && userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (incoming().role == 'CITIZEN' || isBootstrappedAdmin());

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'ward', 'updatedAt'])
          )
        );

      allow delete: if isValidId(userId) && isAdmin();

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if false;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming())
          && incoming().uid == request.auth.uid
          && incoming().updatedAt == request.time;

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && (isOwner(userId) || isAdmin())
          && isValidUserPrivateInfo(incoming())
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'citizenPhone', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidId(docId) && isAdmin();
      }
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedAdmin();

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidAdminRecord(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && (
          isAdmin() ||
          (isBootstrappedAdmin() && userId == request.auth.uid && incoming().grantedBy == request.auth.uid)
        );

      allow update: if false;
      allow delete: if isValidId(userId) && isBootstrappedAdmin();
    }

    match /complaints/{complaintId} {
      allow get: if isValidId(complaintId) && isSignedIn() && (
        existing().visibility == 'PUBLIC' ||
        existing().reporterUid == request.auth.uid ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        existing().visibility == 'PUBLIC' ||
        existing().reporterUid == request.auth.uid ||
        isBootstrappedAdmin()
      );

      allow create: if isVerifiedUser()
        && isValidId(complaintId)
        && isValidComplaint(incoming())
        && incoming().reporterUid == request.auth.uid
        && (incoming().status == 'New' || isAdmin())
        && incoming().upvoteCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(complaintId)
        && isValidComplaint(incoming())
        && incoming().reporterUid == existing().reporterUid
        && incoming().ticketCode == existing().ticketCode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (existing().status != 'Resolved' || isAdmin())
        && (
          // Tier 1: Admin override
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'assignedTeam', 'department', 'departmentId',
            'severity', 'priorityScore', 'resolvedAt', 'timeRemaining', 'updatedAt'
          ])) ||
          // Tier 2: Assigned Department Officer operational workflow
          (isDepartmentOfficerFor(existing().departmentId) && incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'assignedTeam', 'resolvedAt', 'timeRemaining', 'updatedAt'
          ])) ||
          // Tier 3: Citizen atomic upvote (+1 paired with /upvotes/{uid} creation)
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['upvoteCount', 'updatedAt'])
            && incoming().upvoteCount == existing().upvoteCount + 1
            && !exists(/databases/$(database)/documents/complaints/$(complaintId)/upvotes/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/complaints/$(complaintId)/upvotes/$(request.auth.uid))
          )
        );

      allow delete: if isValidId(complaintId) && isVerifiedUser() && (
        isAdmin() ||
        (existing().reporterUid == request.auth.uid && existing().status == 'New')
      );

      match /upvotes/{userId} {
        allow get: if isValidId(complaintId) && isValidId(userId) && isSignedIn() && (
          isOwner(userId) || isAdmin()
        );
        allow list: if isSignedIn() && existing().userId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(complaintId)
          && isValidId(userId)
          && isOwner(userId)
          && isValidComplaintUpvote(incoming())
          && incoming().userId == request.auth.uid
          && incoming().complaintId == complaintId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/complaints/$(complaintId))
          && getAfter(/databases/$(database)/documents/complaints/$(complaintId)).data.upvoteCount
             == get(/databases/$(database)/documents/complaints/$(complaintId)).data.upvoteCount + 1;

        allow update: if false;
        allow delete: if isValidId(complaintId) && isValidId(userId) && isAdmin();
      }
    }

    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (
        existing().recipientUid == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().recipientUid == request.auth.uid || isBootstrappedAdmin()
      );

      allow create: if isVerifiedUser()
        && isValidId(notificationId)
        && isValidAppNotification(incoming())
        && (incoming().recipientUid == request.auth.uid || isAdmin())
        && incoming().createdAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(notificationId)
        && isValidAppNotification(incoming())
        && existing().recipientUid == request.auth.uid
        && incoming().recipientUid == existing().recipientUid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['read']);

      allow delete: if isValidId(notificationId) && isVerifiedUser() && (
        existing().recipientUid == request.auth.uid || isAdmin()
      );
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId) && isSignedIn();
      allow list: if false;

      allow create: if isValidId(settingId)
        && isAdmin()
        && isValidPlatformSettings(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;

      allow update: if isValidId(settingId)
        && isAdmin()
        && isValidPlatformSettings(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'modelAccuracy', 'autoDispatch', 'criticalSLAHours', 'highSLAHours',
          'notificationSound', 'updatedBy', 'updatedAt'
        ]);

      allow delete: if isValidId(settingId) && isAdmin();
    }
  }
}
