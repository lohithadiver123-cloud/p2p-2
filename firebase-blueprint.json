{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user role and operational assignment metadata (non-PII).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Firebase Auth UID of the user."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Public display name for the citizen, officer, or administrator."
        },
        "role": {
          "type": "string",
          "enum": ["CITIZEN", "DEPARTMENT_OFFICER", "ADMIN"],
          "description": "RBAC role controlling portal permissions."
        },
        "departmentId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 64,
          "description": "Assigned department ID when role is DEPARTMENT_OFFICER."
        },
        "departmentName": {
          "type": "string",
          "maxLength": 120,
          "description": "Human-readable department name."
        },
        "ward": {
          "type": "string",
          "maxLength": 32,
          "description": "Residential or operational ward."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["uid", "displayName", "role", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII record for user email and phone number.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "citizenPhone": {
          "type": "string",
          "maxLength": 32
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted database record marking an administrator UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "grantedBy": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "grantedBy", "createdAt"]
    },
    "Complaint": {
      "title": "Complaint",
      "description": "Civic incident ticket triaged across 18 municipal sectors.",
      "type": "object",
      "properties": {
        "ticketCode": {
          "type": "string",
          "pattern": "^CL-[0-9]{1,10}$",
          "maxLength": 20
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "sectorId": {
          "type": "string",
          "pattern": "^[0-9]{2}$",
          "maxLength": 4
        },
        "sectorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sectorIcon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "severity": {
          "type": "string",
          "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
        },
        "priorityScore": {
          "type": "number"
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "departmentId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": ["New", "Assigned", "In Progress", "Resolved"]
        },
        "ward": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "locationName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "reportedAt": {
          "type": "string",
          "maxLength": 64
        },
        "resolvedAt": {
          "type": "string",
          "maxLength": 64
        },
        "reporterUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "citizenName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "language": {
          "type": "string",
          "maxLength": 64
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "aiReasoning": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "recommendedAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "assignedTeam": {
          "type": "string",
          "maxLength": 120
        },
        "slaHours": {
          "type": "number"
        },
        "timeRemaining": {
          "type": "string",
          "maxLength": 32
        },
        "visibility": {
          "type": "string",
          "enum": ["PUBLIC", "PRIVATE"]
        },
        "upvoteCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ticketCode",
        "title",
        "description",
        "sectorId",
        "sectorName",
        "sectorIcon",
        "severity",
        "priorityScore",
        "department",
        "departmentId",
        "status",
        "ward",
        "locationName",
        "lat",
        "lng",
        "reportedAt",
        "reporterUid",
        "citizenName",
        "aiReasoning",
        "recommendedAction",
        "slaHours",
        "visibility",
        "upvoteCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "ComplaintUpvote": {
      "title": "ComplaintUpvote",
      "description": "Single-user confirmation/upvote record on a civic complaint.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "complaintId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "complaintId", "createdAt"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "Real-time notification targeted to a specific user.",
      "type": "object",
      "properties": {
        "recipientUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "type": {
          "type": "string",
          "enum": ["critical", "success", "info"]
        },
        "ticketId": {
          "type": "string",
          "maxLength": 64
        },
        "read": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["recipientUid", "title", "message", "type", "read", "createdAt"]
    },
    "PlatformSettings": {
      "title": "PlatformSettings",
      "description": "Global SLA and neural triage configuration document.",
      "type": "object",
      "properties": {
        "modelAccuracy": {
          "type": "string",
          "maxLength": 64
        },
        "autoDispatch": {
          "type": "boolean"
        },
        "criticalSLAHours": {
          "type": "number"
        },
        "highSLAHours": {
          "type": "number"
        },
        "notificationSound": {
          "type": "boolean"
        },
        "updatedBy": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "modelAccuracy",
        "autoDispatch",
        "criticalSLAHours",
        "highSLAHours",
        "notificationSound",
        "updatedBy",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Non-PII role and operational assignment profile per authenticated user."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII document (email, phone) accessible only by the owner or verified admins."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted collection of administrator UIDs."
    },
    "/complaints/{complaintId}": {
      "schema": { "$ref": "#/entities/Complaint" },
      "description": "Civic complaints submitted by citizens and managed by department officers and admins."
    },
    "/complaints/{complaintId}/upvotes/{userId}": {
      "schema": { "$ref": "#/entities/ComplaintUpvote" },
      "description": "Per-user upvote subcollection enforcing 1-upvote-per-user atomically with complaint.upvoteCount."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/AppNotification" },
      "description": "User-scoped real-time incident notifications."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/PlatformSettings" },
      "description": "Platform SLA thresholds and triage settings managed by admins."
    }
  }
}
